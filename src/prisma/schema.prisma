// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum PartOfSpeechType {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  DETERMINER
  INTERJECTION
  AUXILIARY_VERB
}

enum WordLearningStatus {
  NEW
  RECOGNIZED
  KNOWN
  ACTIVE
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String

  vocabulary UserWord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Word {
  id   String @id @default(uuid())
  name String @unique

  partsOfSpeech WordCategory[]
  users         UserWord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model WordCategory {
  id       String            @id @default(uuid())
  wordId   String
  category PartOfSpeechType

  word          Word               @relation(fields: [wordId], references: [id], onDelete: Cascade)
  meanings      WordMeaning[]
  variations    WordVariation[]
  irregularForm IrregularVerbForm?

  @@unique([wordId, category])
}

model WordMeaning {
  id             String @id @default(uuid())
  wordCategoryId String
  meaning        String

  wordCategory WordCategory @relation(fields: [wordCategoryId], references: [id], onDelete: Cascade)

  @@index([wordCategoryId])
}

model WordVariation {
  id             String @id @default(uuid())
  wordCategoryId String
  form           String
  type           String
  translations   String[]

  wordCategory WordCategory @relation(fields: [wordCategoryId], references: [id], onDelete: Cascade)

  @@unique([wordCategoryId, form])
}

model IrregularVerbForm {
  id             String @id @default(uuid())
  wordCategoryId String @unique

  pastSimple              String
  pastSimpleTranslations  String[]

  pastParticiple             String
  pastParticipleTranslations String[]

  wordCategory WordCategory @relation(fields: [wordCategoryId], references: [id], onDelete: Cascade)
}

model UserWord {
  id     String @id @default(uuid())
  userId String
  wordId String

  status WordLearningStatus @default(NEW)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, wordId])
  @@index([userId])
}

